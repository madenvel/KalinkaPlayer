#!/usr/bin/env bash
set -euo pipefail

# --- Constants (can be overridden by maintainer scripts) ---
USER="kalusr"
INSTALL_DIR="/opt/kalinka"
VENV_DIR="$INSTALL_DIR/venv"
WHEELS_DIR="$INSTALL_DIR/wheels"
WHEEL="$WHEELS_DIR/kalinka_plugin_sdk-@VERSION@-py3-none-any.whl"

echo "[1/5] Ensure system user exists (nologin, no home)"
if ! id -u "$USER" >/dev/null 2>&1; then
  adduser --system --no-create-home --group --disabled-login "$USER"
  # For ALSA access later if needed; harmless if unused
  usermod -aG audio "$USER" || true
else
  # Harden an existing account if created differently before
  usermod -s /usr/sbin/nologin "$USER" || true
  usermod -aG audio "$USER" || true
fi

echo "[2/5] Ensure install directories exist (root-owned)"
install -d -m 0755 "$INSTALL_DIR"
install -d -m 0755 "$WHEELS_DIR"

echo "[3/5] Create venv if missing (root-owned, read-only for runtime)"
if [ ! -d "$VENV_DIR" ]; then
  python3 -m venv "$VENV_DIR"
fi
# Make sure code/venv stays root-owned and not group/world-writable
chown -R root:root "$INSTALL_DIR"
chmod -R go-w "$INSTALL_DIR"

echo "[4/5] Install SDK wheel into the venv"
if [ ! -f "$WHEEL" ]; then
  echo "Error: SDK wheel not found at: $WHEEL" >&2
  echo "Ensure the package placed the wheel under $WHEELS_DIR before postinst." >&2
  exit 1
fi
"$VENV_DIR/bin/pip" install --upgrade pip
"$VENV_DIR/bin/pip" install "$WHEEL"

echo "[5/5] Done"
echo "Kalinka Plugin SDK installed into $VENV_DIR (root-owned)."
echo "Service user '$USER' exists with login disabled. No services restarted."