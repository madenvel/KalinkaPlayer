#!/bin/bash
set -e

# Define variables
VENV_DIR=/opt/kalinka/venv
INSTALL_DIR=/opt/kalinka
WHEEL="$INSTALL_DIR/wheels/kalinka_plugin_sdk-@VERSION@-py3-none-any.whl"
USER=kalusr

echo "Installing Kalinka Plugin SDK to $VENV_DIR"

# Create system user if it doesn't exist
if ! id "$USER" &>/dev/null; then
    echo "Creating system user $USER"
    adduser --system --no-create-home --group $USER
    usermod -aG audio $USER
    mkhomedir_helper $USER
fi

USER_HOME=$(sudo -u "$USER" sh -c 'echo $HOME')

# Ensure user home directories exist with proper permissions
mkdir -p $USER_HOME/.local/share/kalinka
chown $USER:$USER -R $USER_HOME/.local/share/kalinka

# Check if Kalinka venv exists, create if it doesn't
if [ ! -d "$VENV_DIR" ]; then
    echo "Creating Kalinka virtual environment at $VENV_DIR"
    python3 -m venv $VENV_DIR
else
    echo "Virtual environment already exists at $VENV_DIR"
fi

# Install the wheel package using the venv's pip directly
if [ -d "$INSTALL_DIR/wheels" ] && [ -n "$(ls $WHEEL 2>/dev/null)" ]; then
    echo "Installing Kalinka Plugin SDK from wheel package..."
    # Install the wheel
    $VENV_DIR/bin/pip install --upgrade pip
    $VENV_DIR/bin/pip install $WHEEL
else
    echo "Error: Kalinka Plugin SDK wheel package not found"
    exit 1
fi

# Fix ownership of the entire installation directory
chown -R $USER:$USER /opt/kalinka

echo "Kalinka Plugin SDK installation complete."
echo "The SDK is now available in the Kalinka virtual environment at $VENV_DIR"