#!/bin/bash
set -e

# Define variables
VENV_DIR=/opt/kalinka/venv
INSTALL_DIR=/opt/kalinka
SDK_DIR=/opt/kalinka/sdk

echo "Installing Kalinka Plugin SDK to $VENV_DIR"

# Check if Kalinka venv exists, create if it doesn't
if [ ! -d "$VENV_DIR" ]; then
    echo "Creating Kalinka virtual environment at $VENV_DIR"
    python3 -m venv $VENV_DIR
fi

# Create SDK directory
mkdir -p $SDK_DIR

# Activate virtual environment and install the package
source $VENV_DIR/bin/activate

# Install the wheel package
if [ -d "$INSTALL_DIR/wheels" ] && [ -n "$(ls $INSTALL_DIR/wheels/kalinka_plugin_sdk*.whl 2>/dev/null)" ]; then
    echo "Installing Kalinka Plugin SDK from wheel package..."
    # Install the wheel
    pip install --upgrade pip
    pip install $INSTALL_DIR/wheels/kalinka_plugin_sdk*.whl
else
    echo "Error: Kalinka Plugin SDK wheel package not found"
    exit 1
fi

deactivate

echo "Kalinka Plugin SDK installation complete."
echo "The SDK is now available in the Kalinka virtual environment at $VENV_DIR"