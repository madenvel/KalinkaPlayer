#!/bin/bash
set -e

# Define variables
VENV_DIR=/opt/kalinka/venv
SCRIPT_DIR=/usr/bin
STARTUP_SCRIPT=/etc/systemd/system/kalinka.service
USER=kalusr
INSTALL_DIR=/opt/kalinka
CONFIG_DIR=/etc/kalinka

echo "Creating system user"
adduser --system --no-create-home --group $USER
usermod -aG audio $USER
mkhomedir_helper $USER

USER_HOME=$(sudo -u "$USER" sh -c 'echo $HOME')

mkdir -p $USER_HOME/.local/share/kalinka
chown $USER:$USER -R $USER_HOME/.local/share/kalinka

# Create configuration directory with proper permissions
mkdir -p $CONFIG_DIR
chown $USER:$USER $CONFIG_DIR
chmod 755 $CONFIG_DIR

# Check if virtual environment already exists
if [ ! -d "$VENV_DIR" ]; then
    echo "Creating virtual environment"
    python3 -m venv $VENV_DIR
else
    echo "Virtual environment already exists at $VENV_DIR"
fi

# Check for wheel packages
if [ ! -d "$INSTALL_DIR/wheels" ] || [ -z "$(ls $INSTALL_DIR/wheels/*.whl 2>/dev/null)" ]; then
    echo "Error: No wheel packages found in $INSTALL_DIR/wheels/"
    echo "Wheel-based installation is required."
    exit 1
fi

echo "Installing from wheel package..."
# Install the wheel and its dependencies using the venv's pip directly
$VENV_DIR/bin/pip install --upgrade pip
$VENV_DIR/bin/pip install $INSTALL_DIR/wheels/*.whl

# Fix ownership of the entire installation directory
chown -R $USER:$USER /opt/kalinka

# Fix ownership of configuration directory
chown -R $USER:$USER $CONFIG_DIR

# Reload systemd and enable the service
systemctl daemon-reload
systemctl enable kalinka.service
systemctl restart kalinka.service

echo "Installation complete. The Kalinka Player service is now running."