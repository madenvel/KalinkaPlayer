#!/usr/bin/env bash
set -euo pipefail

# --- Configurable paths/users ---
USER="kalusr"
INSTALL_DIR="/opt/kalinka"
CONFIG_DIR="/etc/kalinka"
UNIT_NAME="kalinka.service"
UNIT_PATH="/etc/systemd/system/${UNIT_NAME}"
RESTART_PATH_UNIT="kalinka-restart.path"
RESTART_PATH_UNIT_PATH="/etc/systemd/system/${RESTART_PATH_UNIT}"
UPGRADE_PATH_UNIT="kalinka-upgrade.path"
UPGRADE_PATH_UNIT_PATH="/etc/systemd/system/${UPGRADE_PATH_UNIT}"

case "$1" in
  configure)
    echo "[1/4] Ensure system user exists (nologin)"
    if ! id -u "$USER" >/dev/null 2>&1; then
      adduser --system --no-create-home --group --disabled-login "$USER"
    else
      usermod -s /usr/sbin/nologin "$USER" || true
    fi

    # No audio group: the server stopped opening sound devices when playback
    # moved to the renderer, and the renderer now runs as its own user. Drop
    # the membership older versions granted — unless a renderer old enough to
    # still run as kalusr is installed here, which would lose its sound card
    # the moment we did. Its own upgrade moves it off kalusr, and the next
    # server upgrade finishes this.
    RENDERER_UNIT=/usr/lib/systemd/system/kalinka-renderer.service
    if id -nG "$USER" 2>/dev/null | tr ' ' '\n' | grep -qx audio; then
      if [ -f "$RENDERER_UNIT" ] && grep -q '^User=kalusr' "$RENDERER_UNIT"; then
        echo "      leaving $USER in 'audio': kalinka-renderer still runs as $USER"
      else
        gpasswd -d "$USER" audio >/dev/null 2>&1 || true
      fi
    fi

    echo "[2/4] Create install/config directories"
    install -d -m 0755 "$INSTALL_DIR"
    install -d -m 0750 -o "$USER" -g "$USER" "$CONFIG_DIR"
    # Default music drop-off folder (matches the localfiles plugin's
    # music_folders default). World-writable on purpose: any local user
    # (or SFTP login) can drop music in without sudo — this is a
    # single-admin appliance, not a multi-tenant box. Sticky bit so
    # uploaders can only delete their own files; setgid so new files
    # land in the kalusr group (note: their mode still follows the
    # uploader's umask, so the service can't *read* a 0600 drop).
    # Never touched if it already exists — it's admin territory.
    [ -d /srv/kalinka ] || install -d -m 0755 /srv/kalinka
    if [ ! -d /srv/kalinka/music ]; then
      install -d -m 3777 -o root -g "$USER" /srv/kalinka/music
    fi

    echo "[3/4] Lock down config permissions"
    chown -R "$USER:$USER" "$CONFIG_DIR"
    # Files 0600, directories 0700
    find "$CONFIG_DIR" -type f -exec chmod 600 {} \;
    find "$CONFIG_DIR" -type d -exec chmod 700 {} \;

    echo "[4/4] systemd: reload; enable/start if units exist"
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/kalinka.conf || true
    systemctl daemon-reload
    if [ -f "$RESTART_PATH_UNIT_PATH" ]; then
      systemctl enable --now "$RESTART_PATH_UNIT"
    else
      echo "Note: $RESTART_PATH_UNIT not found at $RESTART_PATH_UNIT_PATH. Skipping."
    fi
    if [ -f "$UPGRADE_PATH_UNIT_PATH" ]; then
      systemctl enable --now "$UPGRADE_PATH_UNIT"
    else
      echo "Note: $UPGRADE_PATH_UNIT not found at $UPGRADE_PATH_UNIT_PATH. Skipping."
    fi
    if [ -f "$UNIT_PATH" ]; then
      systemctl enable "$UNIT_NAME"
      systemctl restart "$UNIT_NAME"
      systemctl --no-pager --full status "$UNIT_NAME" || true
    else
      echo "Note: $UNIT_NAME not found at $UNIT_PATH. Skipping enable/start."
    fi

    echo "Installation complete."
    ;;

  triggered)
    echo "[triggered] Restarting $UNIT_NAME to pick up new wheels..."
    systemctl restart "$UNIT_NAME" || true
    ;;
esac
