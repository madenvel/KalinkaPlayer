#!/usr/bin/env bash
set -euo pipefail

# --- Configurable paths/users ---
USER="kalusr"
INSTALL_DIR="/opt/kalinka"
CONFIG_DIR="/etc/kalinka"
UNIT_NAME="kalinka.service"
UNIT_PATH="/etc/systemd/system/${UNIT_NAME}"
RESTART_PATH_UNIT="kalinka-restart.path"
RESTART_PATH_UNIT_PATH="/etc/systemd/system/${RESTART_PATH_UNIT}"

case "$1" in
  configure)
    echo "[1/4] Ensure system user exists (nologin)"
    if ! id -u "$USER" >/dev/null 2>&1; then
      adduser --system --no-create-home --group --disabled-login "$USER"
      usermod -aG audio "$USER" || true
    else
      usermod -s /usr/sbin/nologin "$USER" || true
      usermod -aG audio "$USER" || true
    fi

    echo "[2/4] Create install/config directories"
    install -d -m 0755 "$INSTALL_DIR"
    install -d -m 0750 -o "$USER" -g "$USER" "$CONFIG_DIR"

    echo "[3/4] Lock down config permissions"
    chown -R "$USER:$USER" "$CONFIG_DIR"
    # Files 0600, directories 0700
    find "$CONFIG_DIR" -type f -exec chmod 600 {} \;
    find "$CONFIG_DIR" -type d -exec chmod 700 {} \;

    echo "[4/4] systemd: reload; enable/start if units exist"
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/kalinka.conf || true
    systemctl daemon-reload
    if [ -f "$RESTART_PATH_UNIT_PATH" ]; then
      systemctl enable --now "$RESTART_PATH_UNIT"
    else
      echo "Note: $RESTART_PATH_UNIT not found at $RESTART_PATH_UNIT_PATH. Skipping."
    fi
    if [ -f "$UNIT_PATH" ]; then
      systemctl enable "$UNIT_NAME"
      systemctl restart "$UNIT_NAME"
      systemctl --no-pager --full status "$UNIT_NAME" || true
    else
      echo "Note: $UNIT_NAME not found at $UNIT_PATH. Skipping enable/start."
    fi

    echo "Installation complete."
    ;;

  triggered)
    echo "[triggered] Restarting $UNIT_NAME to pick up new wheels..."
    systemctl restart "$UNIT_NAME" || true
    ;;
esac
