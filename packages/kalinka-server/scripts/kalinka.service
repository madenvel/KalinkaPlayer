[Unit]
Description=Kalinka Server
# network-online, not network: modules log into remote services during
# setup, and network.target says nothing about connectivity.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=kalusr
Group=kalusr
WorkingDirectory=/opt/kalinka
StateDirectory=kalinka
StateDirectoryMode=0750
LogsDirectory=kalinka
LogsDirectoryMode=0750
RuntimeDirectory=kalinka
RuntimeDirectoryMode=0755
CacheDirectory=kalinka
CacheDirectoryMode=0755

# numba (used by librosa for audio decoding in the CLAP embedder)
# caches its JIT-compiled functions next to the .py source by default.
# Our venv is root-owned and chmodded read-only for kalusr, so numba
# fails with "no locator available for file …/librosa/core/notation.py"
# and that propagates up as "Failed to load audio …" — clap_audio jobs
# get marked failed for every track that hits this path. Redirect the
# cache to /var/cache/kalinka/numba (already in CacheDirectory and
# ReadWritePaths, kalusr-writable).
Environment=NUMBA_CACHE_DIR=/var/cache/kalinka/numba

ExecStartPre=+/opt/kalinka/bootstrap.sh
ExecStart=/opt/kalinka/venv/bin/kalinka-server \
  --config /etc/kalinka/kalinka_conf.cfg \
  --state  /var/lib/kalinka/kalinka_state.json

# Default TimeoutStartSec (90s) is far too tight when bootstrap.sh
# has to install optional packages that lack ARM wheels for the
# current Python version — numpy alone can take 5-10 minutes from
# source on a Pi, essentia-tensorflow + librosa another 10-20 each.
# systemd kills ExecStartPre on timeout, which then loops via
# Restart=on-failure and you never finish the install. `infinity`
# is honest about there being no safe upper bound for a source-build
# pip install on slow hardware; a wedged install is recoverable with
# `systemctl stop kalinka`.
TimeoutStartSec=infinity

Restart=on-failure

ProtectSystem=full
# read-only, not yes: pointing music_folders at /home/<user>/Music is the
# most natural thing for users to do, and with ProtectHome=yes the folder
# silently appears empty inside the sandbox. Reading home is exactly this
# service's job; writing there stays blocked.
ProtectHome=read-only
NoNewPrivileges=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/kalinka /var/log/kalinka /var/cache/kalinka /etc/kalinka

[Install]
WantedBy=multi-user.target