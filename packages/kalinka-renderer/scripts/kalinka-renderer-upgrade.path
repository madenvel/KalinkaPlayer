[Unit]
Description=Watch for kalinka-renderer upgrade requests
# No After=kalinka-renderer.service: a path unit is Before=paths.target,
# so that ordering creates a boot cycle — see kalinka-restart.path.

[Path]
PathChanged=/run/kalinka-renderer/upgrade-request
Unit=kalinka-renderer-upgrade.service

[Install]
WantedBy=multi-user.target
