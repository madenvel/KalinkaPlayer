# Kalinka Player — first-boot configuration.
#
# Rename this file to kalinka-firstboot.conf, edit it, and boot. It is read
# once, applied, and then shredded: a FAT partition has no permissions, and
# this file may carry a Wi-Fi passphrase.
#
# None of it is required. Without a configuration file the machine still boots
# and serves the player at http://<its-ip>:8000 — you just get no shell on it.
#
# Shell syntax: KEY=value, quote anything with spaces.

# Name this machine answers to on the network.
HOSTNAME=kalinka

# The login account to create, in the sudo group. Give it a password, a key,
# or both; with neither it is created locked and cannot log in.
USERNAME=kalinka

# Preferred: a crypt(3) hash, so no plaintext password is ever written to the
# boot partition. Generate one with:
#   mkpasswd -m sha512crypt      (Debian/Ubuntu: apt install whois)
#   openssl passwd -6            (anywhere OpenSSL is installed)
#PASSWORD_HASH='$6$replace$this...'

# Plaintext alternative, hashed on first boot. Convenient, and readable by
# anything that reads the card before the machine does.
#PASSWORD='choose-something'

# Public key for SSH. The whole line from your .pub file.
#SSH_AUTHORIZED_KEY='ssh-ed25519 AAAAC3Nza... you@yourmachine'

# SSH is on by default. Set this to 0 to turn it off.
#SSH_ENABLE=1

# Onboard Wi-Fi. Leave SSID empty to stay on Ethernet. The country code sets
# the regulatory domain and is what unlocks the 5 GHz channels in your region.
#WIFI_SSID='MyNetwork'
#WIFI_PASSWORD='...'
#WIFI_COUNTRY=GB

# IANA zone name, e.g. Europe/London. The clock runs on UTC without it.
#TIMEZONE=Europe/London
