# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.Python
env/
.env
.venv/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.git
.mypy_cache
.pytest_cache
.hypothesis
_version.py
# ...except the SDK's, which is a hand-maintained source file (the SDK no longer
# uses setuptools_scm), not a generated artifact. It is the single source of
# truth for the SDK version.
!packages/kalinka-plugin-sdk/src/kalinka_plugin_sdk/_version.py

# Downloaded archives (e.g. CLI tarballs); never committed
*.tar.gz

# C/C++ build artifacts
*.o
*.d
*.so
*.a
*.lib
*.dll
*.dylib
native_player/build/
native_player/*.so
packages/kalinka-renderer/kalinka-renderer

# CMake's own output. The real builds live in build*/ (already ignored); these
# catch a stray in-source `cmake .`, which otherwise litters the source tree.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
*_include.cmake
*_tests.cmake

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Project specific
kalinka_conf.yaml
kalinka_state.json
kalinka_device_volume.json
test
bin/
native_test

# Debian packaging artifacts
kalinka-player-*
*.deb

# Configuration files (may contain sensitive information)
*.cfg
*.yaml
*.yml
# Root-anchored: source directories named config/ are not runtime
# configuration, and files inside an ignored directory cannot be un-ignored.
/config/
/configs/
# Note: Use *.example extensions for safe template configs
# ...but GitHub metadata (issue templates, workflows) is safe to track
!.github/**/*.yml
!.github/**/*.yaml

# Temporary files
*.tmp
*.temp
.tmp/
.temp/

# Skill-generated evaluation output (e.g. /assess-ai-search)
tmp/ai_search_eval/
tmp/enrichment_assess/
tmp/mtg_jamendo_eval/

# Log files
*.log
logs/

# Virtual environments
venv/
ENV/
env/
pkgroot/
debs/

# ONNX model files (downloaded from GitHub Releases)
models/

# temporary files used for evaluation
tmp/

# Renderer package build artifacts
build-release/
build-rpm/
redhat-linux-build/
.flatpak-builder/
*.rpm
*.flatpak
build-rpm-stage/
