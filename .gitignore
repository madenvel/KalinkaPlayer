# ...except the SDK's, which is a hand-maintained source file (the SDK no longer
# uses setuptools_scm), not a generated artifact. It is the single source of
# truth for the SDK version.
!packages/kalinka-plugin-sdk/src/kalinka_plugin_sdk/_version.py

# Downloaded archives (e.g. CLI tarballs); never committed
*.tar.gz

# C/C++ build artifacts
*.o
*.so
*.a
*.lib
*.dll
*.dylib
native_player/build/
native_player/*.so

# IDE and editor files
